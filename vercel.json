{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [{ "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/javascript" }] }],
  "rewrites": [
    { "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|icon-|assets/).*)", "destination": "/index.html" }
  ]
}
