# Server-side only. Never prefix this with VITE_.
GEMINI_API_KEY=

# Public browser credentials. Access is protected by Supabase Auth and row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push (locked-screen rest alerts). Generate with: npx web-push generate-vapid-keys
# The public key is safe in the browser; never prefix the private key with VITE_.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
