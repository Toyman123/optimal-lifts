# Optional. Everything in OptimalLifts works without this — logging, parsing,
# weight suggestions, and charts are all local and need no key.
#
# Setting a key turns on the "Ask about your progress" panel, which sends your
# training history to Anthropic and is billed per request to your account.
# Get one at https://console.anthropic.com/settings/keys
#
# Copy this file to .env.local (which is gitignored) and restart the server.
ANTHROPIC_API_KEY=
